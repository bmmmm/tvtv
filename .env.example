# Local settings for scripts/deploy.sh and scripts/tv. Copy to .env (git ignores it) and fill in.
# A variable set in the environment wins over this file.

# Names as in docs/pi.md; the old BC101_HOST, BC101_SETUP_HOST, BC101_DIR, BC101_USER still count.
# dem02socialTV's deploy/deploy.sh reads the same keys, so one .env serves both repos.

# scripts/deploy.sh: the deploying login on the Pi, as ssh knows it (an alias from ~/.ssh/config,
# or user@address). Required.
# scripts/social-check.sh logs in there too; it needs no sudo, so any login on the Pi would do.
TVTV_DEPLOY_HOST=tvtv-deploy
# scripts/deploy.sh --setup: a login on the Pi that may sudo; with it the setup runs right away.
TVTV_SETUP_HOST=you@192.0.2.10
# Where the show lives on the Pi and who runs it (these are the defaults).
#TVTV_HOME=/opt/tvtv
#TVTV_USER=zapper

# scripts/tv: the remote. Without these, `tv config` settings, then the ssh alias zapper.
#TV_HOST=192.0.2.10
#TV_USER=zapper
#TV_IDENTITY=~/.ssh/id_ed25519_zapper
