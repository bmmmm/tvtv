#!/usr/bin/env bash
# SPDX-License-Identifier: GPL-3.0-or-later
# The remote's SSH entry point. sshd runs it as ForceCommand for user zapper (system/sshd-tv.conf), so a
# key for that user can do exactly what is listed here and nothing else:
#   ssh zapper                        the zapper (a terminal is needed: ssh -t from scripts)
#   ssh zapper 7  |  ssh zapper 07        switch to channel 7 and hold it
#   ssh zapper status | list | log | next | auto | help
#   ssh zapper tune <ch|name>  |  hold <ch|name>  |  play <ch|name> [seconds]
#   ssh -t zapper doom [wad] [level] [skill]  |  ssh zapper doom list      Doom on the TV, played here
#   ssh zapper upload <name> < name.c  |  rm <name>  |  fetch <name>        admin keys only
#   ssh zapper px <x> <y> <farbe>  |  text <nr> <dein Text>    the social channels, as ssh:<who>
#   ssh zapper social [list | mode]   the bridge tvtv-social: status, its content, the modes
#   ssh zapper social mode <name> | pause | resume | ban <wer> | unban <wer> | bans
#   ssh zapper social rm code <n> | rm text <n> | rm pixel <x> <y> <w> <h>   admin keys only
# Roles: a key's line in /etc/tvtv/authorized_keys ends in "<who> <op|admin>" (tools/tv-keys.sh);
# sshd tells us which key logged in (ExposeAuthInfo). Run by hand, e.g. from the console as user zapper,
# the command comes from the arguments and TVTV_ROLE/TVTV_WHO may set the role.
# Uploads: the file must be C that defines `const Scene scene_<name>`; it is built, run offscreen
# through its whole length (tools/preview.c bench), and only then does the show restart on the new
# binary. If the show does not come back, the previous binary is put back and systemd restarts it.
# The social channels (24 to 26) show what the bridge tvtv-social takes from Mastodon; it has a
# control socket of its own with the show's line protocol, so tvctl talks to it. px and text go
# there as `submit <who> ...` and are checked like a post; whatever else the bridge can change
# takes an admin key here.
set -euo pipefail

TVTV_HOME=${TVTV_HOME:-/opt/tvtv}
TVTV_KEYS=${TVTV_KEYS:-/etc/tvtv/authorized_keys}
TVTV_SOCK=${TVTV_SOCK:-/run/bc101/ctl}
TVTV_UNIT=${TVTV_UNIT:-bc101} # the show's systemd unit; tests name one that does not exist
TVTV_SOCIAL_SOCK=${TVTV_SOCIAL_SOCK:-/run/tvtv-social.sock}
BIN=$TVTV_HOME/bc101  # the show: only for -l (the channel table)
CTL=$TVTV_HOME/tvctl  # the client, built without scene code: an upload cannot break it
DOOM=$TVTV_HOME/fbdoom
DOOM_WADS=${TVTV_WADS:-/mnt /usr/share/games/doom} # where WADs are found: the USB stick first
MAX_UPLOAD=262144 # bytes of C per visual
MAX_VISUALS=32    # channels 30..61
BUILD_TIMEOUT=900 # a full build takes over a minute on the Pi 1
SMOKE_TIMEOUT=180
NAME_RE='^[a-z][a-z0-9_]{0,15}$'
IDENT_RE='^[a-z0-9][a-z0-9_.@:-]{0,63}$' # alice@bonn.social, bonn.social, ssh:bma (docs/steuerung.md)

who=local
role=op

log() { logger -t tvtv -p auth.info -- "$who($role): $*" 2>/dev/null || true; }

die() { # die <rc> <message>
  local rc=$1
  shift
  echo "tv: $*" >&2
  log "$* (rc $rc)"
  exit "$rc"
}

identify() {
  if [[ -n ${SSH_USER_AUTH:-} && -r ${SSH_USER_AUTH} ]]; then
    # sshd wrote the key that got us in; its line in the keys file names the person and the role.
    local method blob found
    read -r method _ blob _ < "$SSH_USER_AUTH" || true
    who=unknown
    role=op
    [[ ${method:-} == publickey && -n ${blob:-} ]] || return 0
    found=$(awk -v b="$blob" '{ for (i = 1; i <= NF; i++) if ($i == b && i + 2 <= NF) { print $(i + 1), $(i + 2); exit } }' \
      "$TVTV_KEYS" 2>/dev/null) || true
    [[ -n $found ]] || return 0
    who=${found% *}
    role=${found#* }
    [[ $role == admin ]] || role=op
  elif [[ -z ${SSH_CONNECTION:-} ]]; then
    who=${TVTV_WHO:-local}
    role=${TVTV_ROLE:-op}
    [[ $role == admin ]] || role=op
  fi
}

need_admin() { [[ $role == admin ]] || die 3 "$1 needs an admin key (you are $who, $role)"; }
valid_name() { [[ $1 =~ $NAME_RE ]]; }
# the show's own names that no visual may take, also before the installed binary lists them: the
# social channels (the Makefile and tools/gen-visuals.sh skip such files too)
reserved() { [[ $1 == pixel || $1 == dem0 || $1 == text ]]; }
valid_target() { [[ $1 =~ ^[0-9]{1,2}$ || $1 =~ $NAME_RE ]]; }
valid_secs() { [[ $1 =~ ^[0-9]{1,4}(\.[0-9]{1,2})?$ ]]; }

ctl() { "$CTL" -s "$TVTV_SOCK" "$@"; }

unit() { systemctl show -p "$1" --value "$TVTV_UNIT" 2>/dev/null || true; } # empty without systemd

# Switched off: the unit exists and neither runs nor is about to. Then every ctl question would
# switch the show on (bc101.socket starts it), so upload and rm must not ask.
show_off() {
  local state
  [[ $(unit LoadState) == loaded ]] || return 1
  state=$(unit ActiveState)
  [[ $state == inactive || $state == failed ]]
}

# "loop", "extra", "visual", "standby" or empty for an unknown name; from the installed binary.
kind_of() { "$BIN" -l 2>/dev/null | awk -v n="$1" '$2 == n { print $NF; exit }'; }

help() {
  cat <<'TXT'
tvtv remote -- ssh zapper [command]
  (nothing)                 the zapper, a remote control in your terminal
  7  or  07                 channel 7, held until next/auto
  next | auto               skip | back to the loop
  tune <ch|name>            hold a channel          play <ch|name> [seconds]   show it once
  status | list | log       what is on | the channels | fps per channel
  doom [wad] [level] [skill]  Doom on the TV, this terminal is the controller (ssh -t);
                            level e1m1..e4m9 or map01..map32, skill 1-5; no level: the menu
  doom list                 the WADs (USB stick, then the system's)
  px <x> <y> <farbe>        a pixel on the pixel wall (channel 24), like a post: px 12 30 rot
  text <nr> <dein Text>     a line of the text page (channel 26), like a post: text 2 Hallo
  social [list | mode]      the social channels' bridge: its status, what it shows, the modes
admin keys:
  upload <name> < name.c    a new visual (channel 30+), C that defines const Scene scene_<name>
  rm <name> | fetch <name>  delete | download the source
  social mode <name>        the bridge's mode    social pause | resume   take nothing | again
  social ban <wer> | unban <wer> | bans     a sender or an instance: alice@bonn.social, ssh:bob
  social rm code <n> | rm text <n> | rm pixel <x> <y> <w> <h>   take something off the tube
TXT
}

# ---------- building ----------

make_q() { # make_q <target>: quiet make with a time limit; the log goes to stderr on failure
  local out
  out=$(mktemp)
  if ! timeout "$BUILD_TIMEOUT" make -s -C "$TVTV_HOME" "$1" > "$out" 2>&1; then
    echo "tv: build failed:" >&2
    grep -v "^make" "$out" | tail -n 25 >&2
    rm -f "$out"
    return 1
  fi
  rm -f "$out"
}

# Renders the whole visual offscreen with the preview tool: a crash, a hang or absurd frame times
# end here, not on the tube. Limits: virtual memory 256 MB, no files bigger than 2 MB, 3 minutes.
smoke() {
  local name=$1 line avg
  echo "tv: test run of $name ..." >&2
  # shellcheck disable=SC2016 # the inner $1 is for the inner bash
  if ! line=$(cd "$TVTV_HOME" && timeout "$SMOKE_TIMEOUT" nice -n 10 bash -c \
    'ulimit -v 262144 -f 4096 2>/dev/null; exec build/preview -f fonts "$1" bench 40' _ "$name" 2>&1); then
    echo "tv: $name failed its test run: ${line:-crashed}" >&2
    return 1
  fi
  echo "tv: $line" >&2
  avg=$(awk '{ print int($3) }' <<< "$line")
  if [[ -n $avg ]] && ((avg > 60)); then
    echo "tv: too slow for the Pi 1 (${avg} ms per frame, budget 20 ms)" >&2
    return 1
  fi
}

# Build the show binary, keep the running one as bc101.prev, restart on the new one and make sure
# it answers. On failure the previous binary is restored (systemd then restarts it if needed).
LIVE= # set by go_live: on (the show runs the new build) or off (it uses it when switched on)

go_live() {
  local want have dead end restarts n pid
  cd "$TVTV_HOME"
  ln -f bc101 bc101.prev
  if ! make_q bc101; then
    rm -f bc101.prev
    return 1
  fi
  want=$(stat -c %i bc101)
  # Switched off: stay off, like a TV whose programme is changed while it is off. Without the
  # unit (tests) a show that refuses the reexec is off.
  if show_off || ! ctl reexec > /dev/null 2>&1; then
    echo "tv: built; the show is off, it uses the new build when it is switched on" >&2
    rm -f bc101.prev
    LIVE=off
    return 0
  fi
  # Up to 12 s for the new binary to answer. It is dead when systemd counts a restart (under
  # bc101.socket a dead show still accepts connections, so silence takes 3 s per question), or,
  # without the unit, when it refuses for 3 s; then the old one goes back right away.
  restarts=$(unit NRestarts)
  dead=0
  end=$((SECONDS + 12))
  while ((SECONDS < end)); do
    sleep 0.5
    have=$(ctl status 2>/dev/null | sed -n 's/.* ino=\([0-9]*\).*/\1/p') || true
    [[ ${have:-} == "$want" ]] && break
    n=$(unit NRestarts)
    [[ -n $restarts && -n $n && $n != "$restarts" ]] && break
    if [[ -z ${have:-} ]]; then ((++dead >= 6)) && break; else dead=0; fi
  done
  if [[ ${have:-} != "$want" ]]; then
    echo "tv: the show did not come back on the new build -- rolling back" >&2
    mv -f bc101.prev bc101
    # A new build that hangs is never restarted by systemd (Restart=on-failure): end it, as the
    # same user, so the next start runs the previous binary.
    pid=$(unit MainPID)
    if [[ ${pid:-0} -gt 0 ]]; then kill -KILL "$pid" 2>/dev/null || true; fi
    return 1
  fi
  rm -f bc101.prev
  LIVE=on
  echo "tv: on air" >&2
}

upload() {
  local name=$1 dst tmp size kind count where
  valid_name "$name" || die 2 "visual name: a-z, 0-9 and _, 1-16 chars, starting with a letter"
  kind=$(kind_of "$name")
  [[ -z $kind || $kind == visual ]] || die 2 "'$name' is a built-in scene"
  ! reserved "$name" || die 2 "'$name' is reserved for the show"
  mkdir -p "$TVTV_HOME/visuals"
  dst=$TVTV_HOME/visuals/$name.c
  if [[ ! -f $dst ]]; then
    count=$(find "$TVTV_HOME/visuals" -maxdepth 1 -name '*.c' | wc -l)
    ((count < MAX_VISUALS)) || die 1 "all $MAX_VISUALS visual channels are taken; rm one first"
  fi
  tmp=$(mktemp "$TVTV_HOME/visuals/.upload.XXXXXX")
  trap 'rm -f "$tmp"' EXIT
  head -c $((MAX_UPLOAD + 1)) > "$tmp"
  size=$(stat -c %s "$tmp")
  ((size > 0)) || die 2 "nothing on stdin -- use: ssh zapper upload $name < $name.c"
  ((size <= MAX_UPLOAD)) || die 2 "more than $MAX_UPLOAD bytes"
  [[ $(LC_ALL=C tr -d '\011\012\015\040-\176\200-\377' < "$tmp" | wc -c) -eq 0 ]] || die 2 "not a text file"
  grep -Eq "^const Scene scene_${name}[[:space:]]*=" "$tmp" ||
    die 2 "the file must define: const Scene scene_$name = {\"$name\", seconds, init_or_NULL, frame, NULL};"
  [[ -f $dst ]] && cp -p "$dst" "$dst.prev"
  chmod 0644 "$tmp"
  mv -f "$tmp" "$dst"
  trap - EXIT
  log "upload $name ($size bytes)"
  if make_q build/preview && smoke "$name" && go_live; then
    rm -f "$dst.prev"
    if [[ $LIVE == on ]]; then where="on air"; else where="built (show off)"; fi
    log "upload $name: $where as channel $("$BIN" -l | awk -v n="$name" '$2 == n { print $1 }')"
    echo "tv: $name is channel $("$BIN" -l | awk -v n="$name" '$2 == n { print $1 }')"
    return 0
  fi
  # rejected: the previous version (if any) returns; the next build regenerates the table
  if [[ -f $dst.prev ]]; then mv -f "$dst.prev" "$dst"; else mv -f "$dst" "$TVTV_HOME/visuals/.$name.c.rejected"; fi
  die 1 "$name was not accepted"
}

remove() {
  local name=$1
  valid_name "$name" || die 2 "bad name"
  [[ -f $TVTV_HOME/visuals/$name.c ]] || die 1 "no visual '$name' (ssh zapper list)"
  # if it is on air, move on first; the restart then has nothing to resume (and asking a show
  # that is off would switch it on)
  if ! show_off && ctl status 2>/dev/null | grep -q "^scene=$name "; then
    ctl next > /dev/null 2>&1 || true
    sleep 1
  fi
  rm -f "$TVTV_HOME/visuals/$name.c" "$TVTV_HOME/build/visuals/$name.o"
  log "rm $name"
  go_live || die 1 "rebuilt without $name, but the show did not come back; it restarts on the previous build"
  echo "tv: $name removed"
}

fetch() {
  local name=$1
  valid_name "$name" || die 2 "bad name"
  [[ -f $TVTV_HOME/visuals/$name.c ]] || die 1 "no visual '$name'"
  cat "$TVTV_HOME/visuals/$name.c"
}

# ---------- doom ----------

is_iwad() { [[ $(head -c 4 "$1" 2>/dev/null | tr -d '\0') == IWAD ]]; } # a game, not an add-on (PWAD)

# has_lump <wad> <NAME>: the WAD's directory names that lump. Header: "IWAD", the number of
# lumps and the directory's offset (little endian); an entry: offset, size, 8 bytes of name.
has_lump() {
  local hdr n ofs
  hdr=$(od -A n -t u4 -j 4 -N 8 "$1" 2>/dev/null) || return 1
  read -r n ofs <<< "$hdr"
  [[ $n =~ ^[0-9]+$ && $ofs =~ ^[0-9]+$ ]] || return 1
  ((n > 0 && n < 65536)) || return 1
  # awk reads everything: no reader that quits early, so no SIGPIPE under pipefail
  od -A n -v -t u1 -j "$ofs" -N $((n * 16)) "$1" 2>/dev/null | awk -v want="$2" '
    { for (i = 1; i <= NF; i++) {
        b[k % 16] = $i; k++
        if (k % 16 == 0) {
          s = ""
          for (j = 8; j < 16 && b[j] > 0; j++) s = s sprintf("%c", b[j])
          if (s == want) found = 1
        } } }
    END { exit !found }'
}

wads() { # the IWAD names, lower case, once each
  local d f n
  for d in $DOOM_WADS; do
    for f in "$d"/*.[wW][aA][dD]; do
      if ! [[ -f $f ]] || ! is_iwad "$f"; then continue; fi
      n=$(basename "${f%.*}" | tr '[:upper:]' '[:lower:]')
      if valid_name "$n"; then echo "$n"; fi
    done
  done | sort -u
}

wad_path() { # the first game <name>.wad in DOOM_WADS, any case; else the first such add-on
  local d f addon=
  for d in $DOOM_WADS; do
    for f in "$d"/*.[wW][aA][dD]; do
      [[ -f $f && $(basename "${f%.*}" | tr '[:upper:]' '[:lower:]') == "$1" ]] || continue
      if is_iwad "$f"; then
        echo "$f"
        return 0
      fi
      addon=${addon:-$f}
    done
  done
  if [[ -n $addon ]]; then echo "$addon"; fi
  return 0
}

# Doom draws while the show waits: `yield` hands the screen to this process, which then becomes
# fbdoom (same pid). It ends with Doom; any zapping meanwhile ends Doom (tools/../src/main.c).
doom() {
  local wad=${1:-freedoom1} level=${2:-} skill=${3:-} path out
  local args=()
  valid_name "$wad" || die 2 "usage: doom [wad] [level] [skill] -- ssh zapper doom list"
  path=$(wad_path "$wad")
  [[ -n $path ]] || die 1 "no WAD '$wad' (ssh zapper doom list)"
  is_iwad "$path" || die 1 "$wad is an add-on (PWAD), not a game"
  case $level in
    "") ;;
    e[1-4]m[1-9]) args+=(-warp "${level:1:1}" "${level:3:1}") ;;
    map0[1-9] | map[12][0-9] | map3[0-2]) args+=(-warp "$((10#${level:3}))") ;;
    *) die 2 "level: e1m1 .. e4m9 or map01 .. map32" ;;
  esac
  # Doom 1 WADs have ExMy, Doom 2 ones MAPxx; -warp would quietly start something else
  [[ -z $level ]] || has_lump "$path" "${level^^}" || die 1 "$wad has no level $level"
  if [[ -n $skill ]]; then
    [[ $skill =~ ^[1-5]$ ]] || die 2 "skill: 1 to 5, after a level"
    args+=(-skill "$skill")
  fi
  [[ -t 0 && -t 1 ]] || die 2 "doom needs a terminal: ssh -t zapper doom"
  [[ -x $DOOM ]] || die 1 "Doom is not built on this TV"
  mkdir -p "$TVTV_HOME/doom"
  out=$(ctl yield $$ 2>&1) || die 1 "no screen from the show: ${out#err }"
  log "doom $wad $level $skill"
  exec env HOME="$TVTV_HOME/doom" FBDOOM_INPUT=/dev/tty "$DOOM" -iwad "$path" "${args[@]}" \
    > "$TVTV_HOME/doom/fbdoom.log" 2>&1
}

# ---------- the social channels ----------

# One request to the bridge's control socket, its reply on stdout; exit 1 for its "err".
social_ctl() {
  [[ -S $TVTV_SOCIAL_SOCK ]] || die 1 "social is not set up on this TV"
  local out rc=0
  out=$("$CTL" -s "$TVTV_SOCIAL_SOCK" "$@" 2>&1) || rc=$?
  ((rc != 2)) || die 1 "the social bridge does not answer (tvtv-social)"
  printf '%s\n' "$out"
  return "$rc"
}

social() {
  local sub=${a[1]:-status} n=${#a[@]} usage="usage: social rm code <n> | rm text <n> | rm pixel <x> <y> <w> <h>"
  case $sub in
    status | list | bans)
      ((n <= 2)) || die 2 "social $sub takes no arguments"
      [[ $sub != bans ]] || need_admin "social bans"
      social_ctl "$sub"
      ;;
    mode)
      if ((n == 2)); then social_ctl mode; return; fi
      [[ $n -eq 3 && ${a[2]} =~ ^[a-z0-9]{1,15}$ ]] || die 2 "usage: social mode [name]"
      need_admin "social mode"
      log "social mode ${a[2]}"
      social_ctl mode "${a[2]}"
      ;;
    pause | resume)
      ((n == 2)) || die 2 "social $sub takes no arguments"
      need_admin "social $sub"
      log "social $sub"
      social_ctl "$sub"
      ;;
    ban | unban)
      [[ $n -eq 3 && ${a[2]} =~ $IDENT_RE ]] || die 2 "usage: social $sub <alice@bonn.social | bonn.social | ssh:bob>"
      need_admin "social $sub"
      log "social $sub ${a[2]}"
      social_ctl "$sub" "${a[2]}"
      ;;
    rm)
      case ${a[2]:-} in
        code | text) [[ $n -eq 4 && ${a[3]} =~ ^[1-8]$ ]] || die 2 "$usage" ;;
        pixel) [[ $n -eq 7 && ${a[3]} =~ ^[0-9]{1,2}$ && ${a[4]} =~ ^[0-9]{1,2}$ && ${a[5]} =~ ^[0-9]{1,2}$ &&
          ${a[6]} =~ ^[0-9]{1,2}$ ]] || die 2 "$usage" ;;
        *) die 2 "$usage" ;;
      esac
      need_admin "social rm"
      log "social ${a[*]:1}"
      social_ctl "${a[@]:1}"
      ;;
    *) die 2 "unknown command 'social $sub' -- ssh zapper help" ;;
  esac
}

# A pixel or a line of the text page from this key, as ssh:<who>: the bridge checks it as it
# checks a post (waiting times, limits, bans), so the key needs a name.
submit() {
  [[ $who != unknown && $who =~ ^[a-z0-9_.-]{1,24}$ ]] || die 3 "${a[0]} needs a key with a name (tv-keys add)"
  log "${a[*]}"
  social_ctl submit "$who" "${a[@]}"
}

# ---------- main ----------

identify
if [[ -n ${SSH_ORIGINAL_COMMAND+x} ]]; then cmd=$SSH_ORIGINAL_COMMAND; else cmd=$*; fi
[[ ${#cmd} -le 80 ]] || die 2 "command too long"
# Only plain words reach the case below: letters, digits, space, dot, underscore, dash, and @ and :
# for the social channels' identities (alice@bonn.social, ssh:bob).
[[ $cmd =~ ^[A-Za-z0-9_.@:\ -]*$ ]] || die 2 "unsupported characters in command"
a=()
read -r -a a <<< "$cmd" || true
case ${a[0]:-} in
  "")
    if [[ -t 0 && -t 1 ]]; then
      log "zapper"
      self=$(readlink -f "${BASH_SOURCE[0]}")
      if [[ $role == admin ]]; then set -- --admin; else set --; fi
      exec env TVTV_DISPATCH="$self" "$CTL" remote -s "$TVTV_SOCK" --name "$who" "$@"
    fi
    help
    ;;
  help | -h | --help) help ;;
  status | list | log | ping) [[ ${#a[@]} -eq 1 ]] || die 2 "${a[0]} takes no arguments"; ctl "${a[0]}" ;;
  next | auto) [[ ${#a[@]} -eq 1 ]] || die 2 "${a[0]} takes no arguments"; log "${a[0]}"; ctl "${a[0]}" ;;
  [0-9] | [0-9][0-9]) [[ ${#a[@]} -eq 1 ]] || die 2 "a channel number stands alone"; log "tune ${a[0]}"; ctl tune "${a[0]}" ;;
  tune | hold)
    { [[ ${#a[@]} -eq 2 ]] && valid_target "${a[1]}"; } || die 2 "usage: ${a[0]} <channel|name>"
    log "${a[0]} ${a[1]}"
    ctl tune "${a[1]}"
    ;;
  play)
    { [[ ${#a[@]} -ge 2 && ${#a[@]} -le 3 ]] && valid_target "${a[1]}"; } || die 2 "usage: play <channel|name> [seconds]"
    [[ ${#a[@]} -eq 2 ]] || valid_secs "${a[2]}" || die 2 "seconds: a number up to 9999"
    log "play ${a[*]:1}"
    ctl play "${a[@]:1}"
    ;;
  doom)
    if [[ ${a[1]:-} == list ]]; then
      [[ ${#a[@]} -eq 2 ]] || die 2 "doom list takes no arguments"
      wads
    else
      [[ ${#a[@]} -le 4 ]] || die 2 "usage: doom [wad] [level] [skill]"
      doom "${a[@]:1}"
    fi
    ;;
  upload) need_admin upload; [[ ${#a[@]} -eq 2 ]] || die 2 "usage: upload <name> < name.c"; upload "${a[1]}" ;;
  rm) need_admin rm; [[ ${#a[@]} -eq 2 ]] || die 2 "usage: rm <name>"; remove "${a[1]}" ;;
  fetch) need_admin fetch; [[ ${#a[@]} -eq 2 ]] || die 2 "usage: fetch <name>"; fetch "${a[1]}" ;;
  social) social ;;
  px)
    [[ ${#a[@]} -eq 4 && ${a[1]} =~ ^[0-9]{1,2}$ && ${a[2]} =~ ^[0-9]{1,2}$ && ${a[3]} =~ ^[A-Za-z0-9]{1,16}$ ]] ||
      die 2 "usage: px <x> <y> <farbe>   x 0-63, y 0-47, farbe 0-15 or a name: px 12 30 rot"
    submit
    ;;
  text)
    [[ ${#a[@]} -ge 3 && ${a[1]} =~ ^[1-8]$ ]] || die 2 "usage: text <nr> <dein Text>   e.g. text 2 Hallo"
    submit
    ;;
  *) die 2 "unknown command '${a[0]}' -- ssh zapper help" ;;
esac
