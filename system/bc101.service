[Unit]
Description=bc101 demo show on the TV (tty1)
After=systemd-user-sessions.service getty@tty1.service
Conflicts=getty@tty1.service

[Service]
ExecStart=/home/deploy/tvtv/bc101
StandardInput=tty
StandardOutput=tty
StandardError=journal
TTYPath=/dev/tty1
TTYReset=yes
TTYVHangup=yes
Restart=on-failure
RestartSec=3

[Install]
WantedBy=multi-user.target
