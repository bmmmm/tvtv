[Unit]
Description=bc101 demo show on the TV (tty1)
After=systemd-user-sessions.service getty@tty1.service tvtv-show.socket
Conflicts=getty@tty1.service
# The control socket comes from tvtv-show.socket, which starts the show on the first remote command.
Requires=tvtv-show.socket
# Room for the rollback after a bad visual: a few quick restarts must not stop the service.
StartLimitIntervalSec=60
StartLimitBurst=10

[Service]
# tools/install.sh fills in the install directory and its owner before installing this unit.
ExecStart=@TVTV_HOME@/bc101
WorkingDirectory=@TVTV_HOME@
User=@TVTV_USER@
SupplementaryGroups=video tty
# /run/tvtv-show: anim.log, for group members (the control socket is /run/tvtv-show.sock).
RuntimeDirectory=tvtv-show
RuntimeDirectoryMode=0750
# Kept when the show stops, so anim.log can still be read.
RuntimeDirectoryPreserve=yes
StandardInput=tty
StandardOutput=tty
StandardError=journal
TTYPath=/dev/tty1
TTYReset=yes
TTYVHangup=yes
Restart=on-failure
RestartSec=3

# Uploaded visuals are code. The show needs the framebuffer, the console and nothing else:
# no network, a read-only file system (its own directory included), no privileges to gain.
NoNewPrivileges=yes
PrivateNetwork=yes
PrivateTmp=yes
ProtectSystem=strict
ProtectHome=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectKernelLogs=yes
ProtectControlGroups=yes
ProtectClock=yes
ProtectHostname=yes
ProtectProc=invisible
ProcSubset=pid
RestrictAddressFamilies=AF_UNIX
IPAddressDeny=any
RemoveIPC=yes
RestrictNamespaces=yes
RestrictRealtime=yes
RestrictSUIDSGID=yes
LockPersonality=yes
MemoryDenyWriteExecute=yes
CapabilityBoundingSet=
SystemCallArchitectures=native
SystemCallFilter=@system-service
SystemCallFilter=~@privileged @resources
DevicePolicy=closed
DeviceAllow=/dev/fb0 rw
DeviceAllow=/dev/tty1 rw
UMask=0027

[Install]
WantedBy=multi-user.target
Also=tvtv-show.socket
