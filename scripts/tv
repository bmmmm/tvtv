#!/usr/bin/env bash
# SPDX-License-Identifier: GPL-3.0-or-later
# The remote from your own terminal: a thin wrapper around ssh.
#   tv                       the zapper
#   tv 7 | tv next | tv auto | tv status | tv list | tv log | tv tune fire | tv play testcard 30
#   tv upload foo.c          a new visual (admin key); the channel's name is the file's name
#   tv rm foo | tv fetch foo > foo.c
#   tv px 12 30 rot | tv text 2 Hallo | tv social [list | mode ...]   the social channels (24-26)
#   tv --host 192.0.2.10 status     one call against another address
#   tv config [host|user|identity [value]]   show or change the settings
# Where the remote is: --host, else TV_HOST, else host= in the settings file, else zapper (an alias
# in ~/.ssh/config with User zapper). TV_HOST, TV_USER and TV_IDENTITY come from the environment
# or from .env at the top of the repo (see .env.example) and win over the settings file
# ($XDG_CONFIG_HOME/tvtv/remote, default ~/.config/tvtv/remote), which holds key=value lines:
#   host=192.0.2.10
#   user=zapper                          the remote's account; empty: ssh decides (the alias)
#   identity=~/.ssh/id_ed25519_zapper    the key (a leading ~ is your home; ~user is not supported); empty: ssh decides
# user and identity apply to every address, --host and TV_HOST included.
set -euo pipefail
here=$(dirname "$(readlink -f "${BASH_SOURCE[0]}" 2> /dev/null || echo "${BASH_SOURCE[0]}")")
if [[ -f $here/env.sh ]]; then
  # shellcheck source=scripts/env.sh
  source "$here/env.sh"
  load_env TV_HOST TV_USER TV_IDENTITY
fi
conf=${XDG_CONFIG_HOME:-$HOME/.config}/tvtv/remote
keys=(host user identity)

setting() { # setting <key>: its value from the settings file, empty if unset; CR and trailing blanks go
  [[ -f $conf ]] || return 0
  tr -d '\r' < "$conf" | sed -n "s/^$1=//p" | tail -n 1 | sed 's/[[:space:]]*$//'
}

config() {
  local target tmp rc=0
  if [[ -z ${1:-} ]]; then
    for k in "${keys[@]}"; do printf '%-9s %s\n' "$k" "$(setting "$k")"; done
    echo "($conf)"
    return
  fi
  case $1 in host | user | identity) ;; *) echo "tv config: keys are ${keys[*]}" >&2; exit 2 ;; esac
  [[ $# -ge 2 ]] || { setting "$1"; return; }
  [[ $2 != *$'\n'* ]] || { echo "tv config: one line per value" >&2; exit 2; }
  mkdir -p "$(dirname "$conf")"
  # a symlinked file (dotfiles) is rewritten where it points, not replaced by a plain file
  target=$conf
  if [[ -L $conf ]]; then
    target=$(readlink "$conf") # one level; plain readlink also works where the target is missing
    [[ $target == /* ]] || target=$(dirname "$conf")/$target
    mkdir -p "$(dirname "$target")"
  fi
  tmp=$target.tmp
  # shellcheck disable=SC2064 # expanded now: tmp is local and gone when the trap runs
  trap "rm -f $(printf %q "$tmp")" EXIT
  if [[ -f $target ]]; then grep -v "^$1=" "$target" > "$tmp" || rc=$?; else : > "$tmp"; fi
  # grep's 1 is "no other lines"; anything else is a read error, and the old file stays as it is
  ((rc <= 1)) || { rm -f "$tmp"; echo "tv config: cannot read $target" >&2; exit 1; }
  [[ -z $2 ]] || printf '%s=%s\n' "$1" "$2" >> "$tmp"
  mv -f "$tmp" "$target"
  echo "$1=${2:-(unset)}"
}

host=${TV_HOST:-}
if [[ ${1:-} == --host ]]; then
  [[ -n ${2:-} ]] || { echo "usage: tv --host <address> [command]" >&2; exit 2; }
  host=$2
  shift 2
fi
[[ ${1:-} == config ]] && { shift; config "$@"; exit; }
host=${host:-$(setting host)}
host=${host:-zapper}
ssh=(ssh)
user=${TV_USER:-$(setting user)}
identity=${TV_IDENTITY:-$(setting identity)}
[[ -n $user ]] && ssh+=(-l "$user")
# IdentitiesOnly: an agent full of other keys would otherwise use up sshd's tries before this one
[[ -n $identity ]] && ssh+=(-i "${identity/#\~/$HOME}" -o IdentitiesOnly=yes)

case ${1:-} in
  "") exec "${ssh[@]}" -t "$host" ;;
  upload)
    [[ -f ${2:-} ]] || { echo "usage: tv upload <file.c>" >&2; exit 2; }
    name=$(basename "${2%.c}")
    exec "${ssh[@]}" "$host" upload "$name" < "$2"
    ;;
  *) exec "${ssh[@]}" "$host" "$@" ;;
esac
